{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "out",
    "dist",
    "build",
    "node_modules",
    "coverage",
    "*.config.cjs",
    "*.config.js"
  ]
}
