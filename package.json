    "test:coverage": "c8 --config .c8rc.json node --test"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "linkedom": "^0.18.12",
    "prettier": "^3.4.2",
    "terser": "^5.37.0"
  }
}
